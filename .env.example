# Copy to .env for local dev (never commit .env).
# LLM coach features are optional — the in-game app does not need these.

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# VRE_LLM_PROVIDER=openai

# Override session archive location for replay export
# VRE_SESSIONS=/path/to/VirtualRaceEngineer/data/sessions

# Pin base setup file when cloning Auto_Tweak.ini
# VRE_BASE_SETUP=MyBaseline.ini

# Enable coach chat API in replay viewer (./replay.sh)
# VRE_COACH=1
